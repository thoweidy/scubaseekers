{
  "name": "scubaseekers-shopify",
  "version": "1.0.0",
  "description": "Shopify store management scripts for scubaseekers",
  "type": "module",
  "scripts": {
    "auth": "shopify store auth --store $SHOPIFY_STORE_DOMAIN --scopes read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,read_customers",
    "products:list": "node scripts/products/list.js",
    "products:low-stock": "node scripts/products/low-stock.js",
    "orders:list": "node scripts/orders/list.js",
    "orders:open": "node scripts/orders/open.js",
    "inventory:check": "node scripts/inventory/check.js",
    "customers:list": "node scripts/customers/list.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
